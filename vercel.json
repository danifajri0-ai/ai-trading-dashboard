{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/"
    },
    "api": {
      "entrypoint": "apps/api/vercel_entry.py",
      "routePrefix": "/backend",
      "excludeFiles": "{apps/web/**,apps/streamlit_app/**,docs/**,tests/**,research/**,runtime/**,venv/**,.pytest_cache/**,pytest_temp/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
